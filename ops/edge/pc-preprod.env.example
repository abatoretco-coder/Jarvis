# Jarvis origin: listen on loopback only during the PC edge rehearsal.
BIND_HOST=127.0.0.1
PUBLIC_EDGE_ENABLED=true
PUBLIC_BASE_URL=https://jarvis.localhost:8443
ALLOWED_ORIGINS=http://tauri.localhost
TRUSTED_PROXY_CIDRS=127.0.0.1/32
EDGE_PROXY_SECRET=replace-with-a-dedicated-random-value-of-at-least-32-characters
HSTS_MAX_AGE_SECONDS=300

# Public mode is human-OIDC only; integrations use separately scoped service keys.
REQUIRE_API_KEY=true
ALLOW_LEGACY_API_KEYS=false
OIDC_ENABLED=true
