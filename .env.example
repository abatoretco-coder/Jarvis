# ── Semantic Router — OpenAI embeddings only ────────────────────────────────
SEMANTIC_ROUTER_ENABLED=false
SEMANTIC_ROUTER_SHADOW_MODE=true
# OpenAI embedding model (text-embedding-3-small recommended)
SEMANTIC_ROUTER_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_ROUTER_ACCEPT_SCORE=0.84
SEMANTIC_ROUTER_MIN_MARGIN=0.08
SEMANTIC_ROUTER_MULTI_INTENT_THRESHOLD=0.50
SEMANTIC_ROUTER_TIMEOUT_MS=5000
SEMANTIC_ROUTER_WARMUP_ON_STARTUP=true
SEMANTIC_ROUTER_WARMUP_BATCH_SIZE=12

# Activation contrôlée des E2 live
SEMANTIC_ROUTER_ACTIVATION_ENABLED=false
SEMANTIC_ROUTER_ACTIVATED_E2_ROUTES=

# Activation contrôlée des E1 live
SEMANTIC_ROUTER_E1_ACTIVATION_ENABLED=false
SEMANTIC_ROUTER_ACTIVATED_E1_ROUTES=
# Exemple complet (Phase 2A + Phase 2B + Phase 2C):
# SEMANTIC_ROUTER_E1_ACTIVATION_ENABLED=true
# SEMANTIC_ROUTER_ACTIVATED_E1_ROUTES=search.deep.analysis,search.deep.history,search.deep.comparison,spotify.search,spotify.search_and_play,spotify.transfer,todo.list_tasks,todo.list_tasks.today,todo.list_tasks.tomorrow,todo.list_tasks.this_week,todo.list_tasks.overdue,todo.list_lists,mail.list_inbox,mail.list_inbox.unread,mail.search_emails,todo.add_task,todo.complete_task,mail.mark_read,mail.mark_unread,todo.update_task,todo.delete_task,todo.create_list,todo.delete_list,todo.add_checklist_item,todo.complete_checklist_item,todo.delete_checklist_item,mail.flag_email
# Exemple Phase 3 (executors Home Assistant):
# SEMANTIC_ROUTER_ACTIVATED_E1_ROUTES=executor.timer,executor.scene_set,executor.cover_open,executor.cover_close

# Activation dédiée des routes E1 high-risk (Phase 2E)
SEMANTIC_ROUTER_E1_HIGH_RISK_ACTIVATION_ENABLED=false
SEMANTIC_ROUTER_ACTIVATED_E1_HIGH_RISK_ROUTES=
SEMANTIC_ROUTER_HIGH_RISK_ACCEPT_SCORE=0.90
SEMANTIC_ROUTER_HIGH_RISK_MIN_MARGIN=0.12
# Important: a high-risk E1 route must be present in BOTH allowlists:
# - SEMANTIC_ROUTER_ACTIVATED_E1_ROUTES
# - SEMANTIC_ROUTER_ACTIVATED_E1_HIGH_RISK_ROUTES
# Exemple complet (Phase 2E):
# SEMANTIC_ROUTER_E1_HIGH_RISK_ACTIVATION_ENABLED=true
# SEMANTIC_ROUTER_ACTIVATED_E1_ROUTES=mail.send_email,mail.reply_email,mail.forward_email,mail.trash_email,executor.lock,executor.unlock,todo.delete_task,todo.delete_list,todo.delete_checklist_item
# SEMANTIC_ROUTER_ACTIVATED_E1_HIGH_RISK_ROUTES=mail.send_email,mail.reply_email,mail.forward_email,mail.trash_email,executor.lock,executor.unlock,todo.delete_task,todo.delete_list,todo.delete_checklist_item
# Server
## Bind address inside Docker.
## Recommended: keep 0.0.0.0 (avoid EADDRNOTAVAIL when binding to a LAN IP inside containers).
BIND_HOST=0.0.0.0
PORT=8090
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576

# Optional: expose a minimal HA entity index (entity_id + friendly_name + state)
EXPOSE_HA_INDEX=false

# Optional: protect /v1/* endpoints (recommended if VM400 is reachable beyond a trusted LAN)
REQUIRE_API_KEY=true
# Single token mode (legacy / simple setup)
API_KEY=
# Multi-token mode (recommended): comma-separated tokens for per-client credentials
# Example: API_KEYS=tok_mobile_xxx,tok_desktop_xxx,tok_admin_xxx
API_KEYS=
# Optional: extra ingress hardening for /v1/ingest (comma-separated IPs)
# Example: INGEST_ALLOWLIST_IPS=127.0.0.1,192.168.1.38
INGEST_ALLOWLIST_IPS=

# Local planner (VM400)
# Planning runs locally in Jarvis via intent words.

# Optional: allow Jarvis to execute `home_assistant.service_call` actions
# If unset, HA actions are returned as skipped (ha_not_configured)
HA_BASE_URL=http://homeassistant:8123
HA_TOKEN=
HA_LONG_LIVED_TOKEN=
HA_TIMEOUT_MS=10000
# Anti-burst guard for HA conversation/OpenAI path
# Minimum delay between two HA conversation calls (milliseconds)
HA_CONVERSATION_MIN_INTERVAL_MS=900
# Retry policy on transient HA/OpenAI errors (429/5xx)
HA_CONVERSATION_RETRY_COUNT=0
HA_CONVERSATION_RETRY_DELAY_MS=1200
# Optional: preferred HA TTS entity for /v1/tts synthesis (example: tts.elevenlabs_text_to_speech)
HA_TTS_ENTITY_ID=
# Optional: comma-separated fallback HA TTS entities (explicit only, no implicit defaults)
# Example: HA_TTS_FALLBACK_ENTITY_IDS=tts.elevenlabs_text_to_speech
HA_TTS_FALLBACK_ENTITY_IDS=

# Incremental summary provider (used by background pre-summary)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_SUMMARY=gpt-4
OPENAI_MODEL_MUSIC_AGENT=gpt-4o-mini
OPENAI_MODEL_ROUTER=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000
OPENAI_STT_TIMEOUT_MS=10000
OPENAI_TTS_TIMEOUT_MS=7000
OPENAI_STT_MODEL=whisper-1
# Optional: force transcription language (example: fr)
OPENAI_STT_LANGUAGE=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
# Optional: voice instructions for gpt-4o-mini-tts (deep voice, pacing, style — native, no artifacts)
# OPENAI_TTS_INSTRUCTIONS=Speak in a deep, calm, authoritative voice. Be clear and well-articulated. Keep a natural conversational pace.

# Optional: TTS audio post-processing via ffmpeg (applied to HA/ElevenLabs; OpenAI pitch is skipped when OPENAI_TTS_INSTRUCTIONS is set)
# TTS_SPEED=1.0              # atempo multiplier — 0.5 (slow) to 2.0 (fast), default 1.0
# TTS_PITCH_SEMITONES=0      # pitch shift in semitones — -12 to +12, default 0
# TTS_CLARITY=false          # highpass 100Hz rumble cut + 3kHz presence boost — true|false

# HA Agent Router — LLM orchestrator
# HA_AGENT_GENERAL: fallback agent used when router is disabled or returns no confident target.
# Override to point to your custom general/conversation agent.
HA_AGENT_GENERAL=conversation.jarvis_conversation
# HA_AGENT_MAP: specialized agents exposed to the router. Leave empty to disable routing.
# Format: "key:entity_id:hint" entries separated by "|"
HA_AGENT_MAP=search.news:search.news:Actualités récentes météo résultats sportifs|search.web:search.web:Recherche factuelle définitions encyclopédiques|search.deep:search.deep:Analyse approfondie histoire sciences longues réponses|executors:conversation.jarvis_executors:Domotique météo locale calendrier minuteurs alarmes lumières prises aspirateur zones audio HA|todo:todo:Microsoft To Do: ajouter lister modifier terminer supprimer tâches sous-tâches listes To Do|mail:mail:Emails Gmail: lire envoyer répondre transférer supprimer marquer flaguer chercher emails
ROUTER_TIMEOUT_MS=3500
ROUTER_CONFIDENCE_THRESHOLD=0.70

# Context and pre-summary limits
# K = hot window (never summarized), M = min new unsummarized messages, N = recent messages injected in context
LIMIT_K=10
LIMIT_M=20
LIMIT_N=16

# Optional: default notify service for `notify.send` (service name without the domain)
# Examples:
# - DEFAULT_NOTIFY_SERVICE=notify
# - DEFAULT_NOTIFY_SERVICE=mobile_app_mon_telephone
DEFAULT_NOTIFY_SERVICE=

# Optional: Timer helper selection (for `timer.requested`)
# If unset, Jarvis will auto-detect a single `timer.*` entity.
# If you have multiple timers, set the one you want here.
# Example: timer.jarvis
TIMER_ENTITY_ID=

# Optional: VM400-side "timer finished" announcement (no HA automation required)
# If configured, Jarvis will schedule a delayed HA call when it receives `timer.requested`.
# Notify target: service name without the domain ("notify" => notify.notify)
TIMER_FINISH_NOTIFY_SERVICE=
TIMER_FINISH_NOTIFY_TITLE=Minuteur

# TTS target: requires both values
# Example:
# TIMER_FINISH_TTS_ENTITY_ID=tts.google_translate_en_com
# TIMER_FINISH_MEDIA_PLAYER_ENTITY_ID=media_player.living_room_speaker
TIMER_FINISH_TTS_ENTITY_ID=
TIMER_FINISH_MEDIA_PLAYER_ENTITY_ID=
TIMER_FINISH_LANGUAGE=fr
TIMER_FINISH_CACHE=true

# Optional: Spotify playback (Home Assistant media_source + media_player)
# If you have multiple Spotify media_player entities, set the one you want to play on.
# Example: media_player.spotify_loic
SPOTIFY_MEDIA_PLAYER_ENTITY_ID=

# Optional: default Spotify content to play when user says e.g. "mets la musique".
#
# Note:
# - On many setups, the Home Assistant Spotify `media_player` does NOT support `media_player.play_media`.
# - To reliably start playback (search / play a URI / play this default), configure Spotify Web API below.
# Examples:
#   SPOTIFY_DEFAULT_PLAY_URI=spotify:playlist:37i9dQZF1DXcBWIGoYBM5M
#   SPOTIFY_DEFAULT_PLAY_URI=https://open.spotify.com/track/...
#   SPOTIFY_DEFAULT_PLAY_URI=spotify:track:...
# SPOTIFY_DEFAULT_PLAY_URI=

# Optional: Google Cast / Chromecast default target (media_player.*)
# Example: media_player.salon_tv
CAST_MEDIA_PLAYER_ENTITY_ID=

# Optional: choose Spotify output source (must match one entry in source_list)
# Example: "Salon" or "Denon AVR-X2000" or "VM400 Librespot"
SPOTIFY_SOURCE=

# Optional: Spotify Web API remote control (pause/play/next/previous/volume)
# You must provide a refresh token.
# Recommended scopes:
# - user-read-playback-state
# - user-modify-playback-state
# - playlist-read-private (to resolve "ma playlist ...")
SPOTIFY_WEBAPI_CLIENT_ID=
SPOTIFY_WEBAPI_CLIENT_SECRET=
SPOTIFY_WEBAPI_REFRESH_TOKEN=
# Optional: target a specific device id (Spotify Connect). Leave empty to control the active device.
SPOTIFY_WEBAPI_DEVICE_ID=
# Optional: fallback device name when SPOTIFY_WEBAPI_DEVICE_ID is not available (example: jarvis Home)
SPOTIFY_WEBAPI_DEVICE_NAME=
# Optional: voice aliases for Spotify target selection
# - "sur téléphone" => alias:phone => this device name (default S22+)
SPOTIFY_WEBAPI_DEVICE_ALIAS_PHONE_NAME=S22+
# - "sur ordinateur" => alias:computer => this device name (if empty, uses SPOTIFY_WEBAPI_DEVICE_NAME)
SPOTIFY_WEBAPI_DEVICE_ALIAS_COMPUTER_NAME=Jarvis
# - "sur salon" => alias:salon => this device name (default librespot)
SPOTIFY_WEBAPI_DEVICE_ALIAS_SALON_NAME=librespot
# Optional: how long Jarvis retries discovery when target hub is missing in Spotify device list
SPOTIFY_WEBAPI_DEVICE_DISCOVERY_RETRIES=2
SPOTIFY_WEBAPI_DEVICE_DISCOVERY_DELAY_MS=500
# Optional: when true, playlist requests only match your own playlists (no public catalog fallback)
SPOTIFY_WEBAPI_USER_PLAYLISTS_ONLY=true
# Optional: advanced overrides (defaults shown)
SPOTIFY_WEBAPI_BASE_URL=https://api.spotify.com
SPOTIFY_WEBAPI_ACCOUNTS_URL=https://accounts.spotify.com
SPOTIFY_WEBAPI_TIMEOUT_MS=8000
SPOTIFY_WEBAPI_REQUEST_RETRIES=2
SPOTIFY_WEBAPI_REQUEST_RETRY_DELAY_MS=350
SPOTIFY_WEBAPI_REQUEST_RETRY_MAX_DELAY_MS=2500
# Optional: bounded retries for idempotent action execution (play/pause/volume/repeat/shuffle)
SPOTIFY_WEBAPI_ACTION_RETRIES=1
SPOTIFY_WEBAPI_ACTION_RETRY_DELAY_MS=1200
# Optional: avoid refresh attempts during predictable network outage window (backup cut)
# Format HH:MM (24h). Default matches your current backup slot.
SPOTIFY_WEBAPI_REFRESH_BLACKOUT_START=00:00
SPOTIFY_WEBAPI_REFRESH_BLACKOUT_END=00:20
# Optional: proactively refresh this long before blackout if token would expire inside it.
SPOTIFY_WEBAPI_PRE_REFRESH_WINDOW_MS=1800000

# Gmail API (Google Cloud OAuth Client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# Optional: Microsoft Graph (To Do)
MS_TENANT_ID=common
MS_CLIENT_ID=
# MS_CLIENT_SECRET=
MS_SCOPES=offline_access Tasks.ReadWrite User.Read
MS_TODO_LIST_NAME=
MS_REFRESH_TOKEN=
# Optional: advanced overrides
# MS_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# MS_GRAPH_BASE_URL=https://graph.microsoft.com
DEFAULT_TIMEZONE=Europe/Paris

# Inbox store (for Android SMS push)
INBOX_STORE_PATH=/app/data/inbox.ndjson

# Conversation memory store (SQLite) for written + voice context
CONVERSATION_DB_PATH=/app/data/conversation-memory.sqlite
CONVERSATION_RECENT_MESSAGES=10

# ── Microsoft Graph — Todo agent ─────────────────────────────────────────────
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations.
# Required scopes: Tasks.ReadWrite  offline_access
#
# How to get a refresh token (one-time interactive flow):
#   1. Build the auth URL (replace CLIENT_ID and REDIRECT_URI):
#      https://login.microsoftonline.com/common/oauth2/v2.0/authorize?client_id=CLIENT_ID&response_type=code&redirect_uri=REDIRECT_URI&scope=Tasks.ReadWrite%20Mail.ReadWrite%20Mail.Send%20offline_access
#   2. Sign in, consent, copy the `code` from the redirect URL.
#   3. POST https://login.microsoftonline.com/common/oauth2/v2.0/token
#      body: client_id, client_secret, code, redirect_uri, grant_type=authorization_code
#   4. Save the `refresh_token` returned.
#
# Use "common" for personal Microsoft accounts (Outlook.com / Hotmail).
# Use your Azure tenant UUID for corporate/work accounts.
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

# ── Google — Gmail mail agent ────────────────────────────────────────────────
# Create OAuth2 credentials at https://console.cloud.google.com → APIs & Services → Credentials.
# Add the Gmail API, create a Desktop OAuth2 client, and obtain a refresh token.
# Required scopes: https://mail.google.com/
#
# How to get a refresh token (one-time):
#   Use `google-auth-library` playground or run:
#   https://developers.google.com/oauthplayground
#   Authorize with "https://mail.google.com/" scope → Exchange code for tokens → save refresh_token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Mail provider override ────────────────────────────────────────────────────
# Mail is Gmail-only. Keep empty or set "gmail".
MAIL_PROVIDER=

# ── OAuth refresh-token persistence ──────────────────────────────────────────
# Rotated refresh tokens returned by Google/Microsoft are persisted here so
# automatic refresh survives Jarvis/container restarts.
OAUTH_REFRESH_TOKEN_STORE_PATH=/app/data/oauth-refresh-tokens.json

# Optional redirect URI used by OAuth helper scripts.
# Example helper usage:
#   npm run oauth:microsoft:url -- --redirect-uri=http://localhost:53682/callback
#   npm run oauth:microsoft:exchange -- --code=... --redirect-uri=http://localhost:53682/callback
#   npm run oauth:google:url -- --redirect-uri=http://localhost:53682/callback
#   npm run oauth:google:exchange -- --code=... --redirect-uri=http://localhost:53682/callback
OAUTH_REDIRECT_URI=http://localhost:53682/callback

# Jarvis backend oneshot OAuth callback (for direct backend callback flow).
# Example: OAUTH_REDIRECT_URI=http://192.168.1.38:8090/v1/oauth/google/callback

# ── Mail multi-account (recommended) ─────────────────────────────────────────
# Unlimited mode: one JSON array containing all accounts.
# Priority order in runtime:
#   1) MAIL_ACCOUNTS_JSON
#   2) MAIL_ACCOUNT_N_* (N=1..5)
#   3) Legacy single-account GOOGLE_*
#
# JSON shape per account:
#   label, provider (gmail), clientId, clientSecret, refreshToken
#
# Example:
# MAIL_ACCOUNTS_JSON=[{"label":"perso","provider":"gmail","clientId":"...","clientSecret":"...","refreshToken":"..."},{"label":"pro","provider":"gmail","clientId":"...","clientSecret":"...","refreshToken":"..."}]
MAIL_ACCOUNTS_JSON=

# ── HA_AGENT_MAP — add todo and mail entries ─────────────────────────────────
# Example with all specialized agents (uncomment and adapt):
#
# todo:todo:Gestion des tâches Microsoft To Do : lister, ajouter, terminer, supprimer des tâches
# mail:mail:Lecture et envoi d'emails : vérifier la boîte de réception, envoyer un email, chercher un message
#
# Combined example:
# HA_AGENT_MAP=search.news:search.news:Actualités récentes météo résultats sportifs|search.web:search.web:Recherche factuelle définitions|todo:todo:Gestion des tâches To Do|mail:mail:Lecture et envoi d'emails

